#!/usr/bin/env bash
# Installs recall from GitHub releases.
#   curl -fsSL https://github.com/rumisle/recall/releases/latest/download/install | bash
#   ... | bash -s -- --version 0.1.0
# RECALL_INSTALL_DIR sets where (default ~/.local/bin).
set -euo pipefail

repo=rumisle/recall
dir=${RECALL_INSTALL_DIR:-$HOME/.local/bin}
version=latest
while [ $# -gt 0 ]; do
  case "$1" in
    --version) version=${2#v}; shift 2 ;;
    *) echo "unknown option: $1" >&2; exit 1 ;;
  esac
done

case "$(uname -s)" in Linux) os=linux ;; Darwin) os=darwin ;; *) echo "unsupported OS: $(uname -s)" >&2; exit 1 ;; esac
case "$(uname -m)" in x86_64 | amd64) arch=x64 ;; arm64 | aarch64) arch=arm64 ;; *) echo "unsupported CPU: $(uname -m)" >&2; exit 1 ;; esac
# An x64 shell under Rosetta on Apple Silicon: take the native build.
if [ "$os-$arch" = darwin-x64 ] && [ "$(sysctl -n sysctl.proc_translated 2>/dev/null)" = 1 ]; then arch=arm64; fi

if [ "$version" = latest ]; then url=https://github.com/$repo/releases/latest/download/recall-$os-$arch.tar.gz
else url=https://github.com/$repo/releases/download/v$version/recall-$os-$arch.tar.gz; fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
echo "downloading $url"
curl -fsSL "$url" | tar -xz -C "$tmp"
mkdir -p "$dir"
mv -f "$tmp/recall" "$dir/recall"
chmod +x "$dir/recall"
echo "installed $("$dir/recall" --version) to $dir/recall"

case ":$PATH:" in
  *":$dir:"*) ;;
  *) echo "note: $dir is not on your PATH; add it, e.g. export PATH=\"$dir:\$PATH\"" ;;
esac
echo "next: recall refresh   (builds the index once; later commands keep it current)"
